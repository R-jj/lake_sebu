# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Secrets — never commit these ──────────────────────────────────────────────
# Android: real key lives here, injected into the build by Gradle
android/local.properties

# Android Firebase config (regenerate with `flutterfire configure`)
android/app/google-services.json

# iOS Firebase config plist
ios/Runner/GoogleService-Info.plist

# Dart Firebase options (regenerate with `flutterfire configure`)
lib/firebase_options.dart

# iOS secrets xcconfig (holds MAPS_API_KEY, sourced by Debug/Release.xcconfig)
ios/Flutter/Secrets.xcconfig

# Kiro AI IDE
.kiro/
